# ---------------------------------------------------------------------------
# Hospital Management System v2.0 — frontend environment (EXAMPLE FILE)
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# Only VITE_* variables are exposed to the browser bundle, so NEVER put a
# secret here: everything prefixed with VITE_ is public. The frontend never
# needs backend secrets — it authenticates with a JWT obtained at login.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the version prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1
