# ---------------------------------------------------------------------------
# Hospital Management System v2.0 — backend environment (EXAMPLE FILE)
#
# Copy this file to `.env` and fill in real local values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials or secrets.
# This file must only ever contain placeholders.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Local PostgreSQL connection string.
# The backend expects a PostgreSQL server running on localhost:5432.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://hms_user:change-me@localhost:5432/hms_dev?schema=public

# JWT signing secret. Generate a strong value and keep it out of Git:
#     openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Access-token lifetime (any `jsonwebtoken` duration string, e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# bcrypt cost factor for password hashing (10–14 is sensible)
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed by CORS (local frontend dev)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Development seed (prisma/seed.ts) — development/demo data only.
# Leave the password fields EMPTY to have the seed generate a random password
# and print it once to the console (recommended for local development).
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Only used when SEED_DEMO_DATA=true (demo doctor/receptionist logins)
SEED_DOCTOR_PASSWORD=
SEED_RECEPTIONIST_PASSWORD=
# Set to true to also seed demo departments, a doctor profile and a patient
SEED_DEMO_DATA=false
